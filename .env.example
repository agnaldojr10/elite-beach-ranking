DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=require"

# Auth.js — gere com: openssl rand -base64 33
AUTH_SECRET=""

# Seed do primeiro administrador (Dono)
